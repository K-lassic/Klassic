# =============================================================================
# K-lassic 프로젝트 .gitignore
# - 기준: git-lab/.gitignore(참고 파일) + project2610/app/.gitignore(기존 API)
# - 스택: Node.js/TypeScript(Express·Vue·Vite) + Python(uv) + Docker
# - 원칙: "소스·설정 템플릿·계약 문서"만 올리고, 비밀값·실행 데이터·빌드 산출물은 제외
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 비밀값(Secret) — 절대 커밋 금지
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
# Docker / CI 에서 쓰는 로컬 비밀 파일
docker-compose.override.yml
.secrets

# -----------------------------------------------------------------------------
# 2. 로그 · 임시 파일 · 실행 중 생성 파일
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.swp
*.swo
*.pid
*.pid.lock
*.sock

# -----------------------------------------------------------------------------
# 3. Node.js / TypeScript / Vue / Vite
# -----------------------------------------------------------------------------
node_modules/
dist/
build/
coverage/
.nyc_output/
*.tsbuildinfo
.vite/
.eslintcache
.npm/
.pnpm-store/

# -----------------------------------------------------------------------------
# 4. Python (model-api, 평가 스크립트)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# 5. 서비스 실행 데이터 (업로드 · 변환 결과 · 로컬 DB)
#    - 운영 데이터는 볼륨(Volume)·오브젝트 스토리지로 관리하고 Git 에는 올리지 않음
# -----------------------------------------------------------------------------
storage/
.devdb/
# 사운드폰트 재제작용 원재료만 제외 (.sf2 본체는 Git LFS 로 관리 — .gitattributes)
assets/soundfonts/source/

# -----------------------------------------------------------------------------
# 6. MLOps 산출물 — 대용량 모델·실험 결과는 Git 대신 레지스트리/스토리지 사용
# -----------------------------------------------------------------------------
mlruns/
wandb/
*.ckpt
*.pt
*.pth
*.onnx
*.safetensors

# -----------------------------------------------------------------------------
# 7. IDE — Visual Studio Code (팀 공유 설정만 허용)
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.vsix
.ionide/
.idea/

# -----------------------------------------------------------------------------
# 8. OS — Windows / macOS
# -----------------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store

# -----------------------------------------------------------------------------
# 9. 저장소 밖에서 관리하는 개인 작업 문서 · 참고 자료 (최상위만)
#    - API 구성은 proto_type/ 에만 둔다
# -----------------------------------------------------------------------------
/jsg_*.md
/docs/
/참고자료/
/export-*.json
