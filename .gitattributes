# =============================================================================
# K-lassic 저장소 공통 속성
# =============================================================================
# 셸 스크립트는 항상 LF — Windows 에서 받아도 bash 가 읽을 수 있게 (CRLF 면 'set: pipefail' 오류)
*.sh        text eol=lf
Dockerfile  text eol=lf
*.Dockerfile text eol=lf

# 사운드폰트(최대 148MB)는 Git LFS — GitHub 일반 파일 한도(100MB)를 넘는다
*.sf2       filter=lfs diff=lfs merge=lfs -text
