# =============================================================================
# K-lassic 저장소 공통 속성
# =============================================================================
# 셸 스크립트는 항상 LF — Windows 에서 받아도 bash 가 읽을 수 있게 (CRLF 면 'set: pipefail' 오류)
*.sh        text eol=lf
Dockerfile  text eol=lf
*.Dockerfile text eol=lf
# #17 SQL 은 LF — 트리거의 DELIMITER 줄 끝에 CR 이 붙으면 mariadb 클라이언트가 구분자를 못 알아본다
*.sql       text eol=lf
# #99 nginx 설정(*.conf)은 LF — Windows 에서 CRLF 로 받은 파일이 커밋에 섞이지 않게 (경로 · 서버 블록 diff 가 줄마다 바뀌어 보이는 것을 막는다)
*.conf      text eol=lf
# #201 PDF 는 바이너리 — 작은 시험 PDF(api/shared/fixtures/upload)를 Git 이 텍스트로 잘못 판정해 autocrlf=true 인 PC 에서 CRLF 로 바꿔 받는 것을 막는다
*.pdf       binary

# 사운드폰트(최대 148MB)는 Git LFS — GitHub 일반 파일 한도(100MB)를 넘는다
*.sf2       filter=lfs diff=lfs merge=lfs -text
