# =============================================================================
# K-lassic 로컬 실행 설정 템플릿 — 복사해서 .env 로 쓴다 (.env 는 Git 에 올리지 않음)
#   이 파일 하나를 docker compose(변수 치환)와 모든 컨테이너(/app/.env)가 함께 읽는다.
#   비밀값 만들기(PowerShell): -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
# =============================================================================

# --- 이미지 태그 (Docker Hub) ------------------------------------------------
DOCKERHUB_NAMESPACE=klassic
# APP_TAG: 이미지 버전 — VERSION 파일 · git 태그(v0.1.0)와 같게 맞춘다
APP_TAG=0.1.0
MARIADB_TAG=12.0

# --- DB (compose 안의 db 컨테이너) -------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_NAME=gugak
DB_USER=gugak
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- 포트 (컨테이너 안) ------------------------------------------------------
WEB_PORT=9523
WEB_HOST=127.0.0.1
ADMIN_PORT=26101
ADMIN_HOST=0.0.0.0
MODEL_API_PORT=9543
MODEL_API_URL=http://127.0.0.1:9543
GATEWAY_PORT=9503
# 내 컴퓨터에 열 포트 (127.0.0.1 에만 열림)
GATEWAY_PUBLISH_PORT=9503
ADMIN_PUBLISH_PORT=26101
# API 활용 안내 화면에 보이는 주소
PUBLIC_API_URL=http://localhost:9503/api

# --- 비밀 --------------------------------------------------------------------
# 필수 · 32자 이상 (없거나 짧으면 web 이 켜지지 않음)
SESSION_SECRET=
# 관리자 화면 → 키 관리 → [서비스 전용 키 발급] 후 채우고: docker compose restart web
SERVICE_API_KEY=
# 172.30.0.1 = docker 네트워크 게이트웨이 (내 컴퓨터 브라우저 → 관리자 포트로 들어올 때의 주소)
ADMIN_ALLOWED_CIDRS=127.0.0.1/32,::1/128,172.30.0.1/32
ADDR_HASH_SALT=

# --- 저장 위치 (컨테이너 안 경로) ---------------------------------------------
STORAGE_DIR=/app/storage
ENGINES_DIR=/opt/gugak-engines

# --- 선택: Ollama (없으면 규칙표로 악기 추천) ----------------------------------
OLLAMA_URL=http://host.docker.internal:11434

# --- 선택: API 예시 홈페이지 (docker compose --profile demo up -d demo) -------
DEMO_PORT=26102
DEMO_API_BASE=http://127.0.0.1:9503/api
DEMO_API_KEY=
