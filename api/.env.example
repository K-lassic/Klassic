# =============================================================================
# K-lassic api — 공통 설정 형식 (값은 .env 에 채운다 · .env 는 Git 제외)
#   서비스별 설정은 각 services/*/.env.example 에 둔다.
#   비밀값은 키 이름만 적고 값은 비워 둔다.
# =============================================================================

# 대역 기본 구성 (#86) — 재구성 model-api 대신 대역을 기본으로 쓸 때만 주석을 푼다 (deploy/README.md 「model-api 대역」)
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=compose.yaml:deploy/compose.standin.yaml

# 호스트 포트 (#20) — proto_type(9503 · 26101)과 같이 띄워도 겹치지 않게 +100
#   9603 · 26201 은 Windows 예약 포트 범위 밖인 것을 2026-10-30 확인했다
API_PUBLIC_PORT=9603      # 입구 (Nginx 사용자 server) — Funnel 이 가리키는 곳
API_ADMIN_PORT=26201      # 관리자 (Nginx 관리자 server) — 127.0.0.1 에만 공개, Funnel 금지

# DB (#20) — 비밀번호는 비워 두고 api/.env 에만 채운다 (예: openssl rand -hex 16)
DB_NAME=klassic
DB_USER=klassic
DB_PASSWORD=
DB_ROOT_PASSWORD=

# 백엔드 (#23) — 비밀값은 비워 두고 api/.env 에만 채운다
SESSION_SECRET=           # 32자 이상 (예: openssl rand -hex 32) — 세션 쿠키 서명
SERVICE_API_KEY=          # backend → model-api 서비스 키 (#26 명령줄 도구로 발급)
ADDR_HASH_SALT=           # 16자 이상 (예: openssl rand -hex 16) — 접속 주소를 원문 없이 해시로만 남길 때 섞는 값 (#27)
SIGNUP_HOURLY_CAP=5       # 같은 접속 주소에서 시간당 가입 수 (#27)
LOG_LEVEL=info
PERIODIC_JOB_SECONDS=21600  # 보관 기간 정리 · 파일 확인 간격(초, 6시간, #85)

# 이미지
DOCKERHUB_NAMESPACE=
APP_TAG=
# #142 엔진 자가 검사: 비워 두면 MODEL_API_IMAGE를 사용한다(미지정 시 klassic/model-api:0.2.3).
# 별도 검사 이미지를 지정할 때만 로컬에 빌드한 재구성 이미지 태그를 넣는다.
ENGINE_CHECK_IMAGE=

# 외부 공개 (Tailscale Funnel) — #9: Tailscale 은 Windows 앱으로 돌려서 인증 키가 필요 없다
# 공개 주소 예: https://<기기>.<tailnet>.ts.net (api/deploy/funnel.ps1 status 로 확인) — 끝에 / 없이
#   비워 두면 로컬 주소 http://127.0.0.1:9603 을 쓴다. API 안내의 외부 주소가 이 값 + /api (#37)
PUBLIC_BASE_URL=
