# #25 엔진 검사 설정. api/에서 실행할 때는 api/.env에 복사하거나 셸로 전달한다.
# 서비스 폴더의 .env가 상위 api/ 실행에도 자동 적용되는 것은 아니다.
# 비밀값은 필요 없다. ENGINE_CHECK_IMAGE는 로컬에 준비된 Linux/amd64 이미지다.
ENGINES_VOLUME_NAME=klassic_engines
ENGINES_DIR=/opt/gugak-engines
ENGINE_CHECK_IMAGE=klassic/klassic-model-api:0.1.1

# 기존 볼륨의 venv·Python 심볼릭 링크는 /opt/gugak-engines 절대 경로를 쓴다.
# 기존 볼륨을 재사용할 때 ENGINES_DIR을 변경하지 않는다.

# #24 HTTP 서비스 설정 — 전체 Compose는 api/.env를 읽는다.
DB_HOST=db
DB_PORT=3306
DB_NAME=klassic
DB_USER=klassic
DB_PASSWORD=
DB_CONNECT_ATTEMPTS=5
DB_RETRY_SECONDS=2
SHARED_DIR=/app/shared
SOUNDFONTS_DIR=/app/shared/soundfonts
JEONGGANBO_DEVICE=cpu
MODEL_LOAD_TIMEOUT_SECONDS=120
RENDER_TIMEOUT_SECONDS=120
# #32 서명 URL은 기본 15분. 고정 비밀값은 실행 환경에서 32바이트 이상으로 주입한다.
# 비워 두면 프로세스별 난수이며 재시작 후 결과를 다시 조회해 URL을 받아야 한다.
FILE_TOKEN_TTL_SECONDS=900
FILE_TOKEN_SECRET=
# #33 공개 API 상한·API 파일 정리. 웹 파일은 별도 서비스가 정리한다.
BUSY_RETRY_AFTER_SECONDS=5
UPLOAD_READ_TIMEOUT_SECONDS=300
MAX_REQUEST_BODY_BYTES=220200960
RECOGNITION_TIMEOUT_MAX_SECONDS=180
PURGE_INTERVAL_SECONDS=600
ORPHAN_RETENTION_HOURS=24
MODEL_API_IMAGE=klassic/model-api:0.2.0
STORAGE_DIR=/storage
ASSETS_DIR=/app/services/model-api/assets
