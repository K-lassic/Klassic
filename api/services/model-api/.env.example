# #25 엔진 검사 설정. api/에서 실행할 때는 api/.env에 복사하거나 셸로 전달한다.
# 서비스 폴더의 .env가 상위 api/ 실행에도 자동 적용되는 것은 아니다.
# 비밀값은 필요 없다. ENGINE_CHECK_IMAGE는 로컬에 준비된 Linux/amd64 이미지다.
ENGINES_VOLUME_NAME=klassic_engines
ENGINES_DIR=/opt/gugak-engines
ENGINE_CHECK_IMAGE=klassic/klassic-model-api:0.1.1

# 기존 볼륨의 venv·Python 심볼릭 링크는 /opt/gugak-engines 절대 경로를 쓴다.
# 기존 볼륨을 재사용할 때 ENGINES_DIR을 변경하지 않는다.
