{
  "name": "@klassic/backend",
  "private": true,
  "type": "module",
  "description": "K-lassic 백엔드 — 사용자 API(web) · 관리자 API(admin). v0.1.1 proto_type/src/app/backend 를 이슈 단위로 새로 작성",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:web": "node dist/server.js --role=web",
    "start:admin": "node dist/server.js --role=admin",
    "test": "vitest run",
    "tool:create-operator": "node dist/tools/createOperator.js",
    "tool:issue-service-key": "node dist/tools/issueServiceKey.js"
  },
  "dependencies": {
    "@gugak/score-core": "file:../../packages/score-core",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.1",
    "multer": "^2.5.0",
    "mysql2": "^3.11.3",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.7.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "~5.5.4",
    "vitest": "^2.1.2"
  }
}
